<section class="card profile">
  <h2>My Profile</h2>
  <div class="profile-flex">
    <% if (me.photo_url) { %>
      <img class="avatar" src="<%= photoBase + me.photo_url %>" alt="Profile photo">
    <% } %>
    <dl class="details">
      <dt>Name</dt><dd><%= me.name %></dd>
      <dt>Email</dt><dd><%= me.email %></dd>
      <dt>Institute</dt><dd><%= me.institute %></dd>
      <dt>Batch</dt><dd><%= me.batch %></dd>
      <dt>Course</dt><dd><%= me.course_name %></dd>
      <dt>Module</dt><dd><%= me.module %></dd>
    </dl>
  </div>
</section>
