# Example environment variables (DO NOT commit real secrets here)
# docker-compose reads this file automatically (compose picks up .env in the repo dir).

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change_this_secret
TOKEN_TTL_HOURS=8

# Admin account (created on first backend boot)
# Leave ADMIN_PASSWORD empty to have a random password generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Database (compose requires these to be set; matches the db service)
MYSQL_ROOT_PASSWORD=change_root_too
MYSQL_DATABASE=dipti_portal
MYSQL_USER=dipti
MYSQL_PASSWORD=changeme

# Used by a bare (non-docker) backend run
DB_HOST=localhost
DB_PORT=3306
DB_USER=dipti
DB_PASSWORD=changeme
DB_NAME=dipti_portal
# Override the full SQLAlchemy URL (e.g. sqlite:///./dev.db for quick local tests)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4

# Backend
UPLOAD_DIR=/opt/dipti/fullstack-app-linux/backend/uploads
CORS_ORIGINS=*
MAX_PHOTO_BYTES=5242880

# Frontend
PORT=3000
BACKEND_API_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=dev-secret-change-me
