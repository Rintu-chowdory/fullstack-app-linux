# Copy to .env and fill in real values. NEVER commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- backend ---
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- database (also used by the frontend's session store) ---
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dipti_portal
DB_USER=dipti
# DATABASE_URL=postgresql+psycopg2://...  # optional: full URL overrides DB_* parts

# --- frontend ---
SESSION_SECRET=change-me
COOKIE_SECURE=0            # set to 1 when serving via HTTPS
# BACKEND_API_BASE_URL=http://127.0.0.1:8000
# TRUST_PROXY=1            # set when running behind HAProxy/reverse proxy

# --- load balancer (prod compose / 6-node lab) ---
STATS_PASSWORD=change-me
VRRP_PASSWORD=change-me

# --- backend tuning (optional) ---
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# CORS_ORIGINS=http://localhost:3000
# MAX_UPLOAD_BYTES=5242880
